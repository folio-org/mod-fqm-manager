{
  "description": "mod-fqm-manager configuration template",
  "moduleDefaults": {
    "resources": [
      {
        "name": "cpu",
        "value": "64",
        "description": "CPU request/limit for container"
      },
      {
        "name": "memory",
        "value": "3000",
        "description": "Memory hard limit for container"
      },
      {
        "name": "memoryReservation",
        "value": "2600",
        "description": "Memory reservation for container"
      }
    ],
    "java": [
      {
        "name": "xmx",
        "value": "2048m",
        "description": "Maximum Java heap size"
      },
      {
        "name": "MaxMetaspaceSize",
        "value": "512m",
        "description": "Maximum Java metaspace size"
      },
      {
        "name": "MetaspaceSize",
        "value": "384m",
        "description": "Initial Java metaspace size"
      }
    ],
    "deployment": {
      "isHaSupported": true,
      "replicasRecommendedCount": 2,
      "description": "Deployment configuration for the backend module. Adjust replicas based on expected load and HA requirements. Set to false if only single instance is supported or required."
    },
    "kong": {
      "timeouts": {
        "connect": "60s",
        "send": "60s",
        "read": "60s"
      },
      "description": "Custom Kong proxy timeouts. Use this only if different from default Kong configuration"
    },
    "EnvVars": [
      {
        "name": "DB_DATABASE",
        "value": null,
        "description": "Database name",
        "type": "DB",
        "essential": true
      },
      {
        "name": "DB_HOST",
        "value": null,
        "description": "Database host",
        "type": "DB",
        "essential": true
      },
      {
        "name": "DB_HOST_READER",
        "value": null,
        "description": "Read-replica database host; falls back to DB_HOST if not set",
        "type": "DB",
        "essential": false
      },
      {
        "name": "DB_MAXPOOLSIZE",
        "value": "12",
        "description": "Maximum database connection pool size",
        "type": "DB",
        "essential": false
      },
      {
        "name": "DB_PASSWORD",
        "value": null,
        "description": "Database password",
        "type": "DB",
        "essential": true
      },
      {
        "name": "DB_PORT",
        "value": null,
        "description": "Database port",
        "type": "DB",
        "essential": true
      },
      {
        "name": "DB_PORT_READER",
        "value": "5432",
        "description": "Port for read-replica database; falls back to DB_PORT if not set",
        "type": "DB",
        "essential": false
      },
      {
        "name": "DB_USERNAME",
        "value": null,
        "description": "Database username",
        "type": "DB",
        "essential": true
      },

      {
        "name": "ENV",
        "value": null,
        "description": "Environment",
        "type": "CONFIG",
        "essential": false
      },
      {
        "name": "JAVA_ARGS",
        "value": null,
        "description": "Java arguments",
        "type": "CONFIG",
        "essential": true
      },
      {
        "name": "JAVA_OPTS",
        "value": null,
        "description": "Java options",
        "type": "CONFIG",
        "essential": true
      },
      {
        "name": "LOG4J_CONFIGURATION_FILE",
        "value": null,
        "description": "Log4j configuration file",
        "type": "CONFIG",
        "essential": false
      },

      {
        "name": "IS_EUREKA",
        "value": true,
        "description": "Set to true when running in Eureka platform mode",
        "type": "FUNCTIONAL",
        "essential": true
      },
      {
        "name": "MAX_QUERY_SIZE",
        "value": "1250000",
        "description": "Maximum number of records a single query can return",
        "type": "FUNCTIONAL",
        "essential": false
      },
      {
        "name": "CONVERT_QUEUED_STATUS_TO_IN_PROGRESS",
        "value": true,
        "description": "Whether to automatically promote queued queries to in-progress status on startup",
        "type": "FUNCTIONAL",
        "essential": false
      },
      {
        "name": "MOD_FQM_MANAGER_QUERY_RETENTION_DURATION",
        "value": "12h",
        "description": "How long completed query results are retained before automatic purge",
        "type": "FUNCTIONAL",
        "essential": false
      }
    ]
  },

  "sidecarDefaults": {
    "resources": [
      {
        "name": "cpu",
        "value": "64",
        "description": "CPU request/limit for container"
      },
      {
        "name": "memory",
        "value": "1024",
        "description": "Memory hard limit for container"
      },
      {
        "name": "memoryReservation",
        "value": "512",
        "description": "Memory reservation for container"
      }
    ],
    "java": [
      {
        "name": "xms",
        "value": "128m",
        "description": "Initial Java heap size"
      },
      {
        "name": "xmx",
        "value": "256m",
        "description": "Maximum Java heap size"
      },
      {
        "name": "MaxMetaspaceSize",
        "value": "96m",
        "description": "Maximum Java metaspace size"
      }
    ],
    "EnvVars": [
      {
        "name": "ENV",
        "value": null,
        "description": "Environment",
        "type": "CONFIG",
        "essential": false
      },
      {
        "name": "JAVA_OPTS",
        "value": null,
        "description": "Additional JVM options for the sidecar process",
        "type": "CONFIG",
        "essential": false
      },
      {
        "name": "MODULE_NAME",
        "value": "mod-fqm-manager",
        "description": "Name of the backend module the sidecar fronts",
        "type": "CONFIG",
        "essential": true
      },
      {
        "name": "MODULE_URL",
        "value": null,
        "description": "Internal URL (host:port) at which the mod-fqm-manager backend container is reachable from its sidecar",
        "type": "CONFIG",
        "essential": true
      },
      {
        "name": "MODULE_VERSION",
        "value": null,
        "description": "Version of the mod-fqm-manager module deployed alongside this sidecar",
        "type": "CONFIG",
        "essential": true
      }
    ]
  }
}
